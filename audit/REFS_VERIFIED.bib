@article{godahewa2025stability,
  author  = {Godahewa, Rakshitha and Bergmeir, Christoph and Erkin Baz, Zeynep and
             Zhu, Chengjun and Song, Zhangdi and Garc{\'i}a, Salvador and Benavides, Dario},
  title   = {On forecast stability},
  journal = {International Journal of Forecasting},
  volume  = {41},
  number  = {4},
  pages   = {1539--1558},
  year    = {2025},
  doi     = {10.1016/j.ijforecast.2025.01.006},
  eprint  = {2310.17332},
  archivePrefix = {arXiv},
  note    = {Record from Crossref; preprint identifier confirmed from the arXiv
             abstract page. Publishes the linear partial-adjustment readout
             ytilde = (1-w_s) yhat_new + w_s ytilde_prev as model-agnostic
             post-processing, and names both vertical and horizontal stability.
             This is C2 prime's quadratic-cost readout map, already in print;
             the project claims no novelty for the form and must cite this.}
}

