@article{genov2026switching,
  author  = {Genov, Evgenii and Ruddick, Julian and Bergmeir, Christoph and
             Vafaeipour, Majid and Coosemans, Thierry and Garc{\'i}a, Salvador and
             Messagie, Maarten},
  title   = {Balancing forecast accuracy and switching costs in online optimization
             of energy management systems},
  journal = {Expert Systems with Applications},
  volume  = {298},
  pages   = {129305},
  year    = {2026},
  doi     = {10.1016/j.eswa.2025.129305},
  eprint  = {2407.03368},
  archivePrefix = {arXiv},
  note    = {Record from Crossref; preprint arXiv:2407.03368 confirmed via the
             Semantic Scholar graph API, which reports the same DOI. NOTE ON THE DOI:
             the form 10.1016/j.eswa.2026.129305 returns HTTP 404 -- the correct stem
             is 2025 even though the issue is dated March 2026. Its equations 18--20
             state the readout-map formulation directly: x_t = M(yhat_t) with M assumed
             Lipschitz with constant L_M, and the switching cost bounded by
             beta * L_M * sum || yhat_t - yhat_{t-v} ||. Its compared arms do not hold
             a level functional fixed -- accuracy and stability move together across
             its commitment periods -- so it is not the matched-level design.}
}

