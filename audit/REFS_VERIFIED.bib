@misc{lade2026bcaci,
  author = {Lade, Ankit and J., Sai Krishna and Kumar, Indar},
  title  = {Bias-Corrected Adaptive Conformal Inference for Multi-Horizon Time
            Series Forecasting},
  year   = {2026},
  eprint = {2604.13253},
  archivePrefix = {arXiv},
  note   = {Record from the arXiv abstract page; submitted 2026-04-14. Unrefereed
             preprint. Contains both an exponentially weighted moving-average smoother
             and an adaptive dead-zone inside an ACI pipeline, but both act on a bias
             estimator upstream of the quantile and modify the interval CENTRE, not the
             width. Its Proposition 3 is the citable general statement that a
             predictable modification of the interval construction preserves ACI's
             long-run coverage when the recursion is fed the deployed interval's
             indicator; the same proof names the monotonicity side condition that a
             width smoother puts at risk.}
}

