@misc{vaze2026simultaneous,
  author = {Vaze, Rahul},
  title  = {Simultaneous Coverage and Efficiency Guarantee in Online Conformal Prediction},
  year   = {2026},
  eprint = {2607.26577},
  archivePrefix = {arXiv},
  primaryClass  = {cs.LG},
  note   = {Preprint, 2026-07-29. Theorem 7 (``Minimax lower bound'') gives, for Model II
            (nonstationary stochastic scalar scores with variation budget V_T),
            inf_A sup R(T) >= c_1 T^{2/3} V_T^{1/3} for dynamic regret R(T), and
            inf_A sup Q(T) >= c_1 f_min T^{2/3} V_T^{1/3} for cumulative coverage error
            Q(T). Remark 11 states the Q(T) bound is NOT tight. See REFS_REJECTED.md.}
}

@inproceedings{srinivas2026efficiency,
  author    = {Srinivas, Vaidehi},
  title     = {Online Conformal Prediction with Efficiency Guarantees},
  booktitle = {Proceedings of the 2026 ACM-SIAM Symposium on Discrete Algorithms (SODA 2026)},
  year      = {2026},
  eprint    = {2507.02496},
  archivePrefix = {arXiv},
  note      = {Verified: any algorithm achieving a mu-approximation in average interval
               length against the best fixed interval achieving coverage in hindsight
               must make a multiplicative factor more mistakes than alpha T, with a
               matching algorithm recovering all Pareto-optimal settings. Efficiency
               here is interval LENGTH, not decision movement cost.}
}

